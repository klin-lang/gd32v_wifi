module gd32v_wifi

import testing

fn test_version_is_four() {
    testing.assert_eq_i32(version(), 4)
}

fn test_err_ok_is_zero() {
    testing.assert_eq_i32(err_ok(), 0)
}

fn test_ipv4_pack() {
    let a: u32 = 192
    let b: u32 = 168
    let c: u32 = 1
    let d: u32 = 50
    testing.assert(ipv4(192, 168, 1, 50) == (a | (b << 8) | (c << 16) | (d << 24)))
}
