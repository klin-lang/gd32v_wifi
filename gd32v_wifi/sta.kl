@[cimport, codename("klin_gd32v_wifi_roaming_get")]
fn klin_gd32v_wifi_roaming_get(): i32

@[cimport, codename("klin_gd32v_wifi_roaming_rssi_th")]
fn klin_gd32v_wifi_roaming_rssi_th(): i32

@[cimport, codename("klin_gd32v_wifi_wps_supported")]
fn klin_gd32v_wifi_wps_supported(): i32

@[cimport, codename("klin_gd32v_wifi_wps_pbc")]
fn klin_gd32v_wifi_wps_pbc(): i32

@[cimport, codename("klin_gd32v_wifi_wps_pin")]
fn klin_gd32v_wifi_wps_pin(pin: str): i32

@[cimport, codename("klin_gd32v_wifi_eap_tls_supported")]
fn klin_gd32v_wifi_eap_tls_supported(): i32

@[cimport, codename("klin_gd32v_wifi_sta_connect_eap_tls")]
fn klin_gd32v_wifi_sta_connect_eap_tls(ssid: str, identity: str, ca_cert: str, client_key: str, client_cert: str, client_key_password: str, phase1: str): i32

@[cimport, codename("klin_gd32v_wifi_sta_connect")]
fn klin_gd32v_wifi_sta_connect(ssid: str, pass: str): i32

@[cimport, codename("klin_gd32v_wifi_sta_wait_connected")]
fn klin_gd32v_wifi_sta_wait_connected(timeout_ms: i32): i32

@[cimport, codename("klin_gd32v_wifi_sta_connected")]
fn klin_gd32v_wifi_sta_connected(): i32

@[cimport, codename("klin_gd32v_wifi_sta_wait_ip")]
fn klin_gd32v_wifi_sta_wait_ip(timeout_ms: i32): i32

@[cimport, codename("klin_gd32v_wifi_sta_ip_u32")]
fn klin_gd32v_wifi_sta_ip_u32(): u32

