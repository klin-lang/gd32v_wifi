/// GD32VW553 Wi‑Fi STA — thin Klin surface over `sta_sdk.c`.
/// Engine = GigaDevice VW55x SDK (`wifi_management` / `wifi_net_ip` / lwIP).
/// Not part of `machine_gd32v` (MMIO Pin…Adc only). Not `esp_wifi` (ESP-IDF).
/// Default IP mode = DHCP; `sta_set_static_ip` is optional. SoftAP is `ap_*`.
/// Scan is `scan_*` (needs `sta_init`). Link stats after `sta_connected`.
/// APSTA (`@v0.5.0`): `concurrent_set(1)` after init, then mix `sta_*` + `ap_*`.
/// Roaming (`@v0.6.0`): `roaming_set(enable, rssi_th)` after `sta_init`.
/// WPS + EAP-TLS (`@v0.7.0`): `wps_*` / `sta_connect_eap_tls` (needs CFG_WPS / CFG_8021x_EAP_TLS).
module gd32v_wifi

@[link("sta_sdk.c")]
@[cimport, codename("klin_gd32v_wifi_sta_set_static_ip")]
fn klin_gd32v_wifi_sta_set_static_ip(ip: u32, gw: u32, netmask: u32): i32

@[cimport, codename("klin_gd32v_wifi_sta_set_hostname")]
fn klin_gd32v_wifi_sta_set_hostname(name: str): i32

@[cimport, codename("klin_gd32v_wifi_sta_init")]
fn klin_gd32v_wifi_sta_init(): i32

@[cimport, codename("klin_gd32v_wifi_concurrent_supported")]
fn klin_gd32v_wifi_concurrent_supported(): i32

@[cimport, codename("klin_gd32v_wifi_concurrent_set")]
fn klin_gd32v_wifi_concurrent_set(enable: i32): i32

