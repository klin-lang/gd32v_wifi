/// GD32VW553 Wi‑Fi STA — thin Klin surface over `sta_sdk.c`.
/// Engine = GigaDevice VW55x SDK (`wifi_management` / `wifi_net_ip` / lwIP).
/// Not part of `machine_gd32v` (MMIO Pin…Adc only). Not `esp_wifi` (ESP-IDF).
/// Default IP mode = DHCP. SoftAP is `ap_*`. Scan is `scan_*` (needs `sta_init`).
module gd32v_wifi

@[link("sta_sdk.c")]
@[cimport, codename("klin_gd32v_wifi_sta_init")]
fn klin_gd32v_wifi_sta_init(): i32

@[cimport, codename("klin_gd32v_wifi_sta_connect")]
fn klin_gd32v_wifi_sta_connect(ssid: str, pass: str): i32

@[cimport, codename("klin_gd32v_wifi_sta_wait_connected")]
fn klin_gd32v_wifi_sta_wait_connected(timeout_ms: i32): i32

@[cimport, codename("klin_gd32v_wifi_sta_connected")]
fn klin_gd32v_wifi_sta_connected(): i32

@[cimport, codename("klin_gd32v_wifi_sta_wait_ip")]
fn klin_gd32v_wifi_sta_wait_ip(timeout_ms: i32): i32

@[cimport, codename("klin_gd32v_wifi_sta_ip_u32")]
fn klin_gd32v_wifi_sta_ip_u32(): u32

@[cimport, codename("klin_gd32v_wifi_sta_gateway_u32")]
fn klin_gd32v_wifi_sta_gateway_u32(): u32

@[cimport, codename("klin_gd32v_wifi_sta_netmask_u32")]
fn klin_gd32v_wifi_sta_netmask_u32(): u32

@[cimport, codename("klin_gd32v_wifi_sta_disconnect")]
fn klin_gd32v_wifi_sta_disconnect(): i32

@[cimport, codename("klin_gd32v_wifi_sta_stop")]
fn klin_gd32v_wifi_sta_stop(): i32

@[cimport, codename("klin_gd32v_wifi_sta_log_ip_info")]
fn klin_gd32v_wifi_sta_log_ip_info()

/// SDK / glue success (0).
pub fn err_ok(): i32 {
    return 0
}

/// Pack `a.b.c.d` into little-endian host `u32` (lwIP on VW553).
pub fn ipv4(a: u32, b: u32, c: u32, d: u32): u32 {
    return a | (b << 8) | (c << 16) | (d << 24)
}

pub fn sta_init(): i32 {
    return klin_gd32v_wifi_sta_init()
}

pub fn sta_connect(ssid: str, pass: str): i32 {
    return klin_gd32v_wifi_sta_connect(ssid, pass)
}

pub fn sta_wait_connected(timeout_ms: i32): i32 {
    return klin_gd32v_wifi_sta_wait_connected(timeout_ms)
}

pub fn sta_connected(): i32 {
    return klin_gd32v_wifi_sta_connected()
}

pub fn sta_wait_ip(timeout_ms: i32): i32 {
    return klin_gd32v_wifi_sta_wait_ip(timeout_ms)
}

pub fn sta_ip_u32(): u32 {
    return klin_gd32v_wifi_sta_ip_u32()
}

pub fn sta_gateway_u32(): u32 {
    return klin_gd32v_wifi_sta_gateway_u32()
}

pub fn sta_netmask_u32(): u32 {
    return klin_gd32v_wifi_sta_netmask_u32()
}

pub fn sta_disconnect(): i32 {
    return klin_gd32v_wifi_sta_disconnect()
}

pub fn sta_stop(): i32 {
    return klin_gd32v_wifi_sta_stop()
}

pub fn sta_log_ip_info() {
    klin_gd32v_wifi_sta_log_ip_info()
}
