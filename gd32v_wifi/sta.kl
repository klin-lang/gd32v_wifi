/// GD32VW553 Wi‑Fi STA — thin Klin surface over `sta_sdk.c`.
/// Engine = GigaDevice VW55x SDK (`wifi_management` / `wifi_net_ip` / lwIP).
/// Not part of `machine_gd32v` (MMIO Pin…Adc only). Not `esp_wifi` (ESP-IDF).
/// Default IP mode = DHCP; `sta_set_static_ip` is optional. SoftAP is `ap_*`.
/// Scan is `scan_*` (needs `sta_init`). Link stats after `sta_connected`.
/// APSTA (`@v0.5.0`): `concurrent_set(1)` after init, then mix `sta_*` + `ap_*`.
module gd32v_wifi

@[link("sta_sdk.c")]
@[cimport, codename("klin_gd32v_wifi_sta_set_static_ip")]
fn klin_gd32v_wifi_sta_set_static_ip(ip: u32, gw: u32, netmask: u32): i32

@[cimport, codename("klin_gd32v_wifi_sta_set_hostname")]
fn klin_gd32v_wifi_sta_set_hostname(name: str): i32

@[cimport, codename("klin_gd32v_wifi_sta_init")]
fn klin_gd32v_wifi_sta_init(): i32

@[cimport, codename("klin_gd32v_wifi_concurrent_supported")]
fn klin_gd32v_wifi_concurrent_supported(): i32

@[cimport, codename("klin_gd32v_wifi_concurrent_set")]
fn klin_gd32v_wifi_concurrent_set(enable: i32): i32

@[cimport, codename("klin_gd32v_wifi_concurrent_get")]
fn klin_gd32v_wifi_concurrent_get(): i32

@[cimport, codename("klin_gd32v_wifi_sta_connect")]
fn klin_gd32v_wifi_sta_connect(ssid: str, pass: str): i32

@[cimport, codename("klin_gd32v_wifi_sta_wait_connected")]
fn klin_gd32v_wifi_sta_wait_connected(timeout_ms: i32): i32

@[cimport, codename("klin_gd32v_wifi_sta_connected")]
fn klin_gd32v_wifi_sta_connected(): i32

@[cimport, codename("klin_gd32v_wifi_sta_wait_ip")]
fn klin_gd32v_wifi_sta_wait_ip(timeout_ms: i32): i32

@[cimport, codename("klin_gd32v_wifi_sta_ip_u32")]
fn klin_gd32v_wifi_sta_ip_u32(): u32

@[cimport, codename("klin_gd32v_wifi_sta_gateway_u32")]
fn klin_gd32v_wifi_sta_gateway_u32(): u32

@[cimport, codename("klin_gd32v_wifi_sta_netmask_u32")]
fn klin_gd32v_wifi_sta_netmask_u32(): u32

@[cimport, codename("klin_gd32v_wifi_sta_disconnect")]
fn klin_gd32v_wifi_sta_disconnect(): i32

@[cimport, codename("klin_gd32v_wifi_sta_stop")]
fn klin_gd32v_wifi_sta_stop(): i32

@[cimport, codename("klin_gd32v_wifi_sta_log_ip_info")]
fn klin_gd32v_wifi_sta_log_ip_info()

@[cimport, codename("klin_gd32v_wifi_sta_rssi")]
fn klin_gd32v_wifi_sta_rssi(): i32

@[cimport, codename("klin_gd32v_wifi_sta_channel")]
fn klin_gd32v_wifi_sta_channel(): i32

@[cimport, codename("klin_gd32v_wifi_sta_authmode")]
fn klin_gd32v_wifi_sta_authmode(): i32

@[cimport, codename("klin_gd32v_wifi_sta_ap_ssid")]
fn klin_gd32v_wifi_sta_ap_ssid(out: *mut u8, max_len: i32): i32

@[cimport, codename("klin_gd32v_wifi_sta_log_link")]
fn klin_gd32v_wifi_sta_log_link()

/// SDK / glue success (0).
pub fn err_ok(): i32 {
    return 0
}

/// Pack `a.b.c.d` into little-endian host `u32` (lwIP on VW553).
pub fn ipv4(a: u32, b: u32, c: u32, d: u32): u32 {
    return a | (b << 8) | (c << 16) | (d << 24)
}

/// Optional static IPv4. `0,0,0` = DHCP (default). Prefer before `sta_connect`.
pub fn sta_set_static_ip(ip: u32, gw: u32, netmask: u32): i32 {
    return klin_gd32v_wifi_sta_set_static_ip(ip, gw, netmask)
}

pub fn sta_set_hostname(name: str): i32 {
    return klin_gd32v_wifi_sta_set_hostname(name)
}

pub fn sta_init(): i32 {
    return klin_gd32v_wifi_sta_init()
}

/// 1 if SDK built with CFG_WIFI_CONCURRENT (host stub always 1).
pub fn concurrent_supported(): bool {
    return klin_gd32v_wifi_concurrent_supported() != 0
}

/// Enter/exit concurrent STA+SoftAP (AN158). After `sta_init` or `ap_init`.
pub fn concurrent_set(enable: i32): i32 {
    return klin_gd32v_wifi_concurrent_set(enable)
}

pub fn concurrent(): i32 {
    return klin_gd32v_wifi_concurrent_get()
}

pub fn sta_connect(ssid: str, pass: str): i32 {
    return klin_gd32v_wifi_sta_connect(ssid, pass)
}

pub fn sta_wait_connected(timeout_ms: i32): i32 {
    return klin_gd32v_wifi_sta_wait_connected(timeout_ms)
}

pub fn sta_connected(): i32 {
    return klin_gd32v_wifi_sta_connected()
}

pub fn sta_wait_ip(timeout_ms: i32): i32 {
    return klin_gd32v_wifi_sta_wait_ip(timeout_ms)
}

pub fn sta_ip_u32(): u32 {
    return klin_gd32v_wifi_sta_ip_u32()
}

pub fn sta_gateway_u32(): u32 {
    return klin_gd32v_wifi_sta_gateway_u32()
}

pub fn sta_netmask_u32(): u32 {
    return klin_gd32v_wifi_sta_netmask_u32()
}

pub fn sta_disconnect(): i32 {
    return klin_gd32v_wifi_sta_disconnect()
}

pub fn sta_stop(): i32 {
    return klin_gd32v_wifi_sta_stop()
}

pub fn sta_log_ip_info() {
    klin_gd32v_wifi_sta_log_ip_info()
}

pub fn sta_rssi(): i32 {
    return klin_gd32v_wifi_sta_rssi()
}

pub fn sta_channel(): i32 {
    return klin_gd32v_wifi_sta_channel()
}

pub fn sta_authmode(): i32 {
    return klin_gd32v_wifi_sta_authmode()
}

/// Associated SSID into caller buffer. Returns length excluding NUL, or `-1`.
pub fn sta_ap_ssid(out: *mut u8, max_len: i32): i32 {
    return klin_gd32v_wifi_sta_ap_ssid(out, max_len)
}

pub fn sta_log_link() {
    klin_gd32v_wifi_sta_log_link()
}
