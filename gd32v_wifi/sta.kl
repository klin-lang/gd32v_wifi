fn klin_gd32v_wifi_sta_log_link()

/// SDK / glue success (0).
pub fn err_ok(): i32 {
    return 0
}

/// Pack `a.b.c.d` into little-endian host `u32` (lwIP on VW553).
pub fn ipv4(a: u32, b: u32, c: u32, d: u32): u32 {
    return a | (b << 8) | (c << 16) | (d << 24)
}

/// Optional static IPv4. `0,0,0` = DHCP (default). Prefer before `sta_connect`.
pub fn sta_set_static_ip(ip: u32, gw: u32, netmask: u32): i32 {
    return klin_gd32v_wifi_sta_set_static_ip(ip, gw, netmask)
}

pub fn sta_set_hostname(name: str): i32 {
    return klin_gd32v_wifi_sta_set_hostname(name)
}

pub fn sta_init(): i32 {
    return klin_gd32v_wifi_sta_init()
}

/// 1 if SDK built with CFG_WIFI_CONCURRENT (host stub always 1).
pub fn concurrent_supported(): bool {
    return klin_gd32v_wifi_concurrent_supported() != 0
}

/// Enter/exit concurrent STA+SoftAP (AN158). After `sta_init` or `ap_init`.
pub fn concurrent_set(enable: i32): i32 {
    return klin_gd32v_wifi_concurrent_set(enable)
}

pub fn concurrent(): i32 {
    return klin_gd32v_wifi_concurrent_get()
}

/// Enable/disable STA roaming. `rssi_th` e.g. `-70`; `0` keeps prior threshold when enabling.
pub fn roaming_set(enable: i32, rssi_th: i32): i32 {
    return klin_gd32v_wifi_roaming_set(enable, rssi_th)
}

pub fn roaming(): i32 {
    return klin_gd32v_wifi_roaming_get()
}

pub fn roaming_rssi_th(): i32 {
    return klin_gd32v_wifi_roaming_rssi_th()
}

/// 1 if SDK built with CFG_WPS (host stub always 1).
pub fn wps_supported(): bool {
    return klin_gd32v_wifi_wps_supported() != 0
}

/// WPS push-button (blocked). After `sta_init`. Needs CFG_WPS.
pub fn wps_pbc(): i32 {
    return klin_gd32v_wifi_wps_pbc()
}

/// WPS PIN (4..=8 digits, blocked). After `sta_init`. Needs CFG_WPS.
pub fn wps_pin(pin: str): i32 {
    return klin_gd32v_wifi_wps_pin(pin)
}

/// 1 if SDK built with CFG_8021x_EAP_TLS (host stub always 1).
pub fn eap_tls_supported(): bool {
    return klin_gd32v_wifi_eap_tls_supported() != 0
}

/// Enterprise EAP-TLS connect (blocked). PEM strings are caller-owned. Empty key password / phase1 OK.
pub fn sta_connect_eap_tls(ssid: str, identity: str, ca_cert: str, client_key: str, client_cert: str, client_key_password: str, phase1: str): i32 {
    return klin_gd32v_wifi_sta_connect_eap_tls(ssid, identity, ca_cert, client_key, client_cert, client_key_password, phase1)
}

pub fn sta_connect(ssid: str, pass: str): i32 {
    return klin_gd32v_wifi_sta_connect(ssid, pass)
}

pub fn sta_wait_connected(timeout_ms: i32): i32 {
    return klin_gd32v_wifi_sta_wait_connected(timeout_ms)
}

pub fn sta_connected(): i32 {
    return klin_gd32v_wifi_sta_connected()
}

pub fn sta_wait_ip(timeout_ms: i32): i32 {
    return klin_gd32v_wifi_sta_wait_ip(timeout_ms)
}

pub fn sta_ip_u32(): u32 {
    return klin_gd32v_wifi_sta_ip_u32()
}

pub fn sta_gateway_u32(): u32 {
    return klin_gd32v_wifi_sta_gateway_u32()
}

pub fn sta_netmask_u32(): u32 {
    return klin_gd32v_wifi_sta_netmask_u32()
}

pub fn sta_disconnect(): i32 {
    return klin_gd32v_wifi_sta_disconnect()
}

pub fn sta_stop(): i32 {
    return klin_gd32v_wifi_sta_stop()
}

pub fn sta_log_ip_info() {
    klin_gd32v_wifi_sta_log_ip_info()
}

pub fn sta_rssi(): i32 {
    return klin_gd32v_wifi_sta_rssi()
}

pub fn sta_channel(): i32 {
    return klin_gd32v_wifi_sta_channel()
}

pub fn sta_authmode(): i32 {
    return klin_gd32v_wifi_sta_authmode()
}

/// Associated SSID into caller buffer. Returns length excluding NUL, or `-1`.
pub fn sta_ap_ssid(out: *mut u8, max_len: i32): i32 {
    return klin_gd32v_wifi_sta_ap_ssid(out, max_len)
}

pub fn sta_log_link() {
    klin_gd32v_wifi_sta_log_link()
}
