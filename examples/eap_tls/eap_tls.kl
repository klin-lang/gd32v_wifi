// GD32VW553 Wi-Fi EAP-TLS via klin-lang/gd32v_wifi @v0.7.0.
// Needs SDK msdk_ffd + CFG_8021x_EAP_TLS. Replace PEM placeholders with real certs.
//   make emit KLIN=/path/to/klin/bin/klin.dart
import "../../gd32v_wifi" wifi

fn main() {
    let mut e = wifi.sta_init()
    if e != wifi.err_ok() {
        return
    }
    if !wifi.eap_tls_supported() {
        return
    }
    // PEM strings are caller-owned (no Klin heap copy of cert blobs beyond .rodata).
    e = wifi.sta_connect_eap_tls(
        "corp-ssid",
        "user@example.com",
        "-----BEGIN CERTIFICATE-----\nCA\n-----END CERTIFICATE-----\n",
        "-----BEGIN PRIVATE KEY-----\nKEY\n-----END PRIVATE KEY-----\n",
        "-----BEGIN CERTIFICATE-----\nCLIENT\n-----END CERTIFICATE-----\n",
        "",
        ""
    )
    if e != wifi.err_ok() {
        return
    }
    e = wifi.sta_wait_ip(30000)
    if e != wifi.err_ok() {
        return
    }
    wifi.sta_log_ip_info()
}
